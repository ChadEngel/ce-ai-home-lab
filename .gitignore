# Never commit cluster backups / snapshots — they can contain Kubernetes
# Secret material (TLS private keys, service-account tokens, helm release
# secrets). Keep them out of the repo entirely.
backups/

# Local scratch / export dirs
# exports/ also holds the UDM config export + offline secrets cache
# (secrets-cache.env, *.unf controller backups, kubeconfig, SSH keys, TLS PEMs)
# — see UDM_REPLACEMENT.md. NEVER commit any of it.
exports/
tmp/
udm-config-*/
secrets-cache.env
*.unf

# Editor / OS noise
.DS_Store
*.swp
*~

# Local secret material (Infisical token cache, downloaded keys, etc.)
.cache/
*.pem
*.key
id_rsa*
id_ed25519*