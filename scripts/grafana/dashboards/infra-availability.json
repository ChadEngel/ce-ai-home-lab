  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "CE AI Lab \u2014 Infrastructure Availability",
  "uid": "infra-availability",
  "version": 0,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service Traffic Lights",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Infrastructure Status",
      "description": "0 = DOWN (red), 1 = RECOVERING (yellow, was down in the last 10 min), 2 = UP (green). UDM = udm_thermal.up; the rest = service_health.up.",
      "datasource": {
        "type": "influxdb",
        "uid": "dfdkew37wk1dse"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "dfdkew37wk1dse"
          },
          "query": "udmUp = from(bucket: \"network_metrics\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"udm_thermal\" and r._field == \"up\")\n  |> group()\n  |> map(fn: (r) => ({ r with service: \"udm\" }))\n  |> keep(columns: [\"_time\", \"_value\", \"service\"])\n\nsvcUp = from(bucket: \"kube_metrics\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"service_health\" and r._field == \"up\")\n  |> keep(columns: [\"_time\", \"_value\", \"service\"])\n\nallUp = union(tables: [udmUp, svcUp]) |> group(columns: [\"service\"])\ncurrent = allUp |> last() |> keep(columns: [\"service\", \"_value\"]) |> rename(columns: {_value: \"current\"})\nrecent  = allUp |> min()  |> keep(columns: [\"service\", \"_value\"]) |> rename(columns: {_value: \"recent\"})\n\njoin(tables: {c: current, r: recent}, on: [\"service\"])\n  |> map(fn: (r) => ({\n      service: r.service,\n      _value: if r.current == 0.0 then 0.0 else if r.recent == 0.0 then 1.0 else 2.0,\n  }))\n  |> keep(columns: [\"service\", \"_value\"])\n  |> yield(name: \"state\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "RECOVERING",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "UP",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "wideLayout": true
      }
    },
    {
      "id": 3,
      "type": "row",
      "title": "Availability & Response Time",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "panels": []
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Availability (1 = up, 0 = down)",
      "description": "Per-service up/down over time (min per window, so any outage shows as a dip to 0).",
      "datasource": {
        "type": "influxdb",
        "uid": "dfdkew37wk1dse"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "dfdkew37wk1dse"
          },
          "query": "udmUp = from(bucket: \"network_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"udm_thermal\" and r._field == \"up\")\n  |> group()\n  |> map(fn: (r) => ({ r with service: \"udm\" }))\n  |> keep(columns: [\"_time\", \"_value\", \"service\"])\n\nsvcUp = from(bucket: \"kube_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"service_health\" and r._field == \"up\")\n  |> keep(columns: [\"_time\", \"_value\", \"service\"])\n\nunion(tables: [udmUp, svcUp])\n  |> group(columns: [\"service\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: min, createEmpty: false)\n  |> yield(name: \"availability\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 18,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "pointSize": 3,
            "showPoints": "never",
            "spanNulls": false,
            "show": {
              "line": true,
              "points": false
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "min",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Response Time (ms)",
      "description": "HTTP round-trip to each service's health endpoint. Rising latency = degrading usability before a hard down.",
      "datasource": {
        "type": "influxdb",
        "uid": "dfdkew37wk1dse"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "dfdkew37wk1dse"
          },
          "query": "from(bucket: \"kube_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"service_health\" and r._field == \"latency_ms\")\n  |> filter(fn: (r) => r._value >= 0.0)\n  |> group(columns: [\"service\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"latency\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "pointSize": 3,
            "showPoints": "never",
            "spanNulls": false,
            "show": {
              "line": true,
              "points": false
            }
          },
          "displayName": "${__field.labels.service}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}