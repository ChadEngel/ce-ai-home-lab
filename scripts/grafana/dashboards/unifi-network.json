    {
      "id": 2,
      "type": "timeseries",
      "title": "WAN Bandwidth — Comcast (active) & Verizon (failover)",
      "description": "Internet throughput from the UDM Pro WAN ports. Comcast = eth8 (public IP), Verizon = eth9 (failover). Derived from cumulative rx/tx byte counters × 8 = bits/sec.",
      "datasource": {
        "type": "influxdb",
        "uid": "dfdkew37wk1dse"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "dfdkew37wk1dse"
          },
          "query": "from(bucket: \"network_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"usg_wan_ports\" and (r._field == \"rx_bytes\" or r._field == \"tx_bytes\"))\n  |> derivative(unit: 1s, nonNegative: true)\n  |> map(fn: (r) => ({ r with _value: r._value * 8.0,\n      wan: if r.ifname == \"eth8\" then \"Comcast\" else if r.ifname == \"eth9\" then \"Verizon\" else r.ifname,\n      dir: if r._field == \"rx_bytes\" then \"Download\" else \"Upload\" }))\n  |> group(columns: [\"wan\", \"dir\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"wan\")"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "pointSize": 3,
            "showPoints": "never",
            "spanNulls": false,
            "show": {
              "line": true,
              "points": false
            }
          },
          "displayName": "${__field.labels.wan} ${__field.labels.dir}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
