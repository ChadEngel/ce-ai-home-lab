{
  "uid": "udm-syslog",
  "title": "UDM Pro \u2014 Syslog",
  "description": "UDM Pro remote syslog via syslog-ng on caelx004 -> Loki. The receiver drops the firewall default-deny 'no rule description' spam (~94% of raw volume) so these panels reflect signal. Raw unfiltered logs remain on caelx004 at /data/udm-pro/udm.log.",
  "tags": [
    "udm",
    "loki",
    "syslog"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "label": "Host",
        "query": {
          "query": "label_values({job=\"udm-syslog\"}, host)",
          "refId": "A"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "severity",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "label": "Severity",
        "query": {
          "query": "label_values({job=\"udm-syslog\"}, severity)",
          "refId": "A"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
