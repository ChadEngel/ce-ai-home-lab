        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory Usage",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "dfdkew37wk1dse"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"host_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mem\" and (r._field == \"used\" or r._field == \"available\") and r.host =~ /${host:regex}/)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"host\", \"_field\"])\n",
          "queryType": "flux",
          "legend": "{{host}} \u2014 {{_field}}",
          "datasource": {
            "type": "influxdb",
            "uid": "dfdkew37wk1dse"
          }
