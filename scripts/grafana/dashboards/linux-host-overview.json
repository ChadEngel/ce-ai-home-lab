        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "bargauge",
      "title": "Disk Usage % (per mount)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "dfdkew37wk1dse"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"host_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"disk\" and (r._field == \"used_percent\") and r.host =~ /${host:regex}/ and r.path !~ /^\\/sys\\//)\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> group(columns: [\"host\", \"path\"])\n",
          "queryType": "flux",
          "legend": "{{host}} {{path}}",
          "datasource": {
            "type": "influxdb",
            "uid": "dfdkew37wk1dse"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "gradient"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Network Throughput (physical NICs)",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "dfdkew37wk1dse"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"host_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"net\" and (r._field == \"bytes_recv\" or r._field == \"bytes_sent\") and r.host =~ /${host:regex}/ and r.interface =~ /^(enp|ens|eth|eno|wlan|wlp)/)\n  |> derivative(unit: 1s, nonNegative: true)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"host\", \"interface\", \"_field\"])\n",
          "queryType": "flux",
          "legend": "{{host}} \u2014 {{interface}} {{_field}}",
          "datasource": {
            "type": "influxdb",
            "uid": "dfdkew37wk1dse"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Disk I/O (whole disks)",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "dfdkew37wk1dse"
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"host_metrics\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"diskio\" and (r._field == \"read_bytes\" or r._field == \"write_bytes\") and r.host =~ /${host:regex}/ and r.name =~ /^(nvme[0-9]+n[0-9]+|sd[a-z]|vd[a-z])$/)\n  |> derivative(unit: 1s, nonNegative: true)\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"host\", \"name\", \"_field\"])\n",
          "queryType": "flux",
          "legend": "{{host}} \u2014 {{name}} {{_field}}",
          "datasource": {
            "type": "influxdb",
            "uid": "dfdkew37wk1dse"
          }
