{
  "title": "UDM SoC temperature high",
  "ruleGroup": "udm",
  "folder": "UDM Alerts",
  "for": "1m",
  "noDataState": "OK",
  "execErrState": "Error",
  "condition": "C",
  "data": [
    {
      "refId": "A",
      "datasourceUid": "dfdkew37wk1dse",
      "relativeTimeRange": {
        "from": 600,
        "to": 0
      },
      "model": {
        "datasource": {
          "type": "influxdb",
          "uid": "dfdkew37wk1dse"
        },
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "query": "from(bucket: \"network_metrics\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"usg\" and r._field == \"temp_cpu\" and r.mac == \"74:fa:29:54:00:f1\")\n  |> aggregateWindow(every: 1m, fn: max, createEmpty: false)",
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "expression": "A",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "reducer": "last",
        "refId": "B",
        "type": "reduce"
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "conditions": [
          {
            "type": "query",
            "evaluator": {
              "type": "gt",
              "params": [
                80
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "B"
              ]
            },
            "reducer": {
              "type": "last"
            }
          }
        ],
        "expression": "B",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "refId": "C",
        "type": "threshold"
      }
    }
  ],
  "labels": {
    "severity": "critical"
  },
  "annotations": {
    "summary": "UDM CPU die temperature (usg.temp_cpu) is >80\u00b0C for 1+ minute per unpoller. Approaching thermal envelope. Check UDM Temperature panel and airflow."
  }
}