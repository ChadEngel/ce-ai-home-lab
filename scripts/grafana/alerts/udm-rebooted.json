{
  "title": "UDM rebooted",
  "ruleGroup": "udm-thermal",
  "folder": "UDM Alerts",
  "for": "0s",
  "noDataState": "OK",
  "execErrState": "OK",
  "condition": "C",
  "labels": {
    "severity": "info"
  },
  "annotations": {
    "summary": "UDM uptime reset to under 5 minutes — it has just rebooted. Check UDM Uptime, SoC temp and memory on the dashboard to see why."
  },
  "data": [
    {
      "refId": "A",
      "datasourceUid": "dfdkew37wk1dse",
      "relativeTimeRange": { "from": 600, "to": 0 },
      "model": {
        "refId": "A",
        "datasource": { "type": "influxdb", "uid": "dfdkew37wk1dse" },
        "query": "from(bucket: \"network_metrics\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"udm_thermal\" and r._field == \"uptime_s\")\n  |> aggregateWindow(every: 1m, fn: last, createEmpty: false)"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": {
        "type": "reduce",
        "expression": "A",
        "reducer": "last",
        "refId": "B"
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "type": "threshold",
        "expression": "B",
        "conditions": [{ "evaluator": { "type": "lt", "params": [300] } }],
        "refId": "C"
      }
    }
  ]
}
