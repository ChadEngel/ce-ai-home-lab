{
  "title": "UDM memory high (OOM risk)",
  "ruleGroup": "udm",
  "folder": "UDM Alerts",
  "for": "10m",
  "noDataState": "OK",
  "execErrState": "Error",
  "condition": "C",
  "data": [
    {
      "refId": "A",
      "datasourceUid": "dfdkew37wk1dse",
      "relativeTimeRange": {
        "from": 900,
        "to": 0
      },
      "model": {
        "datasource": {
          "type": "influxdb",
          "uid": "dfdkew37wk1dse"
        },
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "query": "from(bucket: \"network_metrics\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r._measurement == \"usg\" and r._field == \"mem\" and r.mac == \"74:fa:29:54:00:f1\")\n  |> aggregateWindow(every: 1m, fn: mean, createEmpty: false)",
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "expression": "A",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "reducer": "last",
        "refId": "B",
        "type": "reduce"
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "conditions": [
          {
            "type": "query",
            "evaluator": {
              "type": "gt",
              "params": [
                88
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "B"
              ]
            },
            "reducer": {
              "type": "last"
            }
          }
        ],
        "expression": "B",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "refId": "C",
        "type": "threshold"
      }
    }
  ],
  "labels": {
    "severity": "warning"
  },
  "annotations": {
    "summary": "UDM memory (usg.mem) >88% for 10+ minutes. earlyoom will start killing processes (likely unifi-core, the controller) when available memory drops below ~10%. This is the precursor to a controller crash loop. See runbooks/udm-unifi-core-crash-loop.md. Consider rebooting the UDM via the web UI, or reduce controller workload (disable DPI, unused apps)."
  }
}
