{
  "title": "UDM syslog \u2014 warning/error spike",
  "ruleGroup": "udm-syslog",
  "folder": "UDM Alerts",
  "for": "10m",
  "noDataState": "OK",
  "execErrState": "OK",
  "condition": "C",
  "labels": {
    "severity": "warning"
  },
  "annotations": {
    "summary": "High-rate error/critical syslog from the UDM \u2014 something is wrong on the network.",
    "description": "Counts err/crit/alert severity events, EXCLUDING known firmware noise (UniFi AP wlan peer-state logging, lighttpd SSL handshake errors from port scanners). Threshold 15 in 15m."
  },
  "data": [
    {
      "refId": "A",
      "datasourceUid": "loki",
      "relativeTimeRange": {
        "from": 3600,
        "to": 0
      },
      "model": {
        "refId": "A",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "expr": "sum(count_over_time({job=\"udm-syslog\"} | severity=~\"err|crit|alert\" !~ \"wlan_objmgr|mod_openssl|SSL: 1 error\" [15m])) or vector(0)",
        "queryType": "range"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": {
        "type": "reduce",
        "expression": "A",
        "reducer": "last",
        "refId": "B"
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "type": "threshold",
        "expression": "B",
        "refId": "C",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [
                15
              ]
            }
          }
        ]
      }
    }
  ]
}