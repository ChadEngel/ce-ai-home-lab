{
  "title": "UDM SoC fan stall",
  "ruleGroup": "udm-thermal",
  "folder": "UDM Alerts",
  "for": "2m",
  "noDataState": "OK",
  "execErrState": "Error",
  "condition": "C",
  "data": [
    {
      "refId": "A",
      "datasourceUid": "dfdkew37wk1dse",
      "relativeTimeRange": {
        "from": 600,
        "to": 0
      },
      "model": {
        "datasource": {
          "type": "influxdb",
          "uid": "dfdkew37wk1dse"
        },
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "query": "from(bucket: \"network_metrics\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"udm_thermal\" and r._field == \"fan2_rpm\")\n  |> aggregateWindow(every: 1m, fn: min, createEmpty: false)\n  |> yield(name: \"fan2\")",
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "expression": "A",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "reducer": "last",
        "refId": "B",
        "type": "reduce"
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "relativeTimeRange": {
        "from": 0,
        "to": 0
      },
      "model": {
        "conditions": [
          {
            "evaluator": {
              "params": [
                800
              ],
              "type": "lt"
            }
          }
        ],
        "expression": "B",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "refId": "C",
        "type": "threshold"
      }
    }
  ]
}
