{
  "title": "UDM offline (unreachable)",
  "ruleGroup": "udm-thermal",
  "folder": "UDM Alerts",
  "for": "2m",
  "noDataState": "OK",
  "execErrState": "OK",
  "condition": "C",
  "labels": {
    "severity": "critical"
  },
  "annotations": {
    "summary": "The udm-thermal collector could not reach the UDM for 2+ minutes (device down or rebooting)."
  },
  "data": [
    {
      "refId": "A",
      "datasourceUid": "dfdkew37wk1dse",
      "relativeTimeRange": { "from": 300, "to": 0 },
      "model": {
        "refId": "A",
        "datasource": { "type": "influxdb", "uid": "dfdkew37wk1dse" },
        "query": "from(bucket: \"network_metrics\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"udm_thermal\" and r._field == \"up\")\n  |> aggregateWindow(every: 1m, fn: min, createEmpty: false)"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": {
        "type": "reduce",
        "expression": "A",
        "reducer": "last",
        "refId": "B"
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "type": "threshold",
        "expression": "B",
        "conditions": [{ "evaluator": { "type": "lt", "params": [1] } }],
        "refId": "C"
      }
    }
  ]
}
