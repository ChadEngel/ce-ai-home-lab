{
  "title": "UDM offline (unreachable)",
  "ruleGroup": "udm",
  "folder": "UDM Alerts",
  "for": "5m",
  "noDataState": "OK",
  "execErrState": "OK",
  "condition": "C",
  "labels": {
    "severity": "critical"
  },
  "annotations": {
    "summary": "The UDM has been in state=0 (disconnected) for 5+ minutes per unpoller. Device is down or rebooting. Check the UDM Uptime panel and the syslog pipeline (caelx004)."
  },
  "data": [
    {
      "refId": "A",
      "datasourceUid": "dfdkew37wk1dse",
      "relativeTimeRange": {
        "from": 600,
        "to": 0
      },
      "model": {
        "refId": "A",
        "datasource": {
          "type": "influxdb",
          "uid": "dfdkew37wk1dse"
        },
        "query": "from(bucket: \"network_metrics\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"usg\" and r._field == \"state\" and r.mac == \"74:fa:29:54:00:f1\")\n  |> aggregateWindow(every: 1m, fn: min, createEmpty: false)"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": {
        "type": "reduce",
        "expression": "A",
        "reducer": "last",
        "refId": "B"
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "type": "threshold",
        "expression": "B",
        "refId": "C",
        "conditions": [
          {
            "type": "query",
            "evaluator": {
              "type": "lt",
              "params": [
                1
              ]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": [
                "B"
              ]
            },
            "reducer": {
              "type": "last"
            }
          }
        ]
      }
    }
  ]
}