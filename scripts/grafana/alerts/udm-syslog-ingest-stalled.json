{
  "title": "UDM syslog \u2014 ingest stalled",
  "ruleGroup": "udm-syslog",
  "folder": "UDM Alerts",
  "for": "30m",
  "noDataState": "Alerting",
  "execErrState": "Alerting",
  "condition": "C",
  "labels": {
    "severity": "critical"
  },
  "annotations": {
    "summary": "UDM syslog has not reached Loki for 30m \u2014 receiver, forwarder, or network path broken, or the ingest-stalled metric itself is missing. Treat NO DATA as failure (the Oct 22-30 outage burned 8 days unnoticed because noDataState was OK). See home-network-config/runbooks/syslog-receiver-problems.md case 2026-10-30.",
    "description": "Fires when the 30m total is < 1. Catches a dead syslog-ng on caelx004 or the UDM dropping the target."
  },
  "data": [
    {
      "refId": "A",
      "datasourceUid": "loki",
      "relativeTimeRange": {
        "from": 1800,
        "to": 0
      },
      "model": {
        "refId": "A",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "expr": "sum(count_over_time({job=\"udm-syslog\"} [30m])) or vector(0)",
        "queryType": "range"
      }
    },
    {
      "refId": "B",
      "datasourceUid": "__expr__",
      "model": {
        "type": "reduce",
        "expression": "A",
        "reducer": "last",
        "refId": "B"
      }
    },
    {
      "refId": "C",
      "datasourceUid": "__expr__",
      "model": {
        "type": "threshold",
        "expression": "B",
        "refId": "C",
        "conditions": [
          {
            "evaluator": {
              "type": "lt",
              "params": [
                1
              ]
            }
          }
        ]
      }
    }
  ],
  "relativeTimeRange": {
    "from": 1800,
    "to": 0
  }
}